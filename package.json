    "three": "^0.170.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.170.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.9",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "@playwright/test": "^1.56.0"
